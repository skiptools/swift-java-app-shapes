{
  "javaPackage": "com.example.shapes.dependencies",
  "mode": "jni",
  "exportMode": "all",
  "failOnSkippedDeclarations": true,
  "memoryManagementMode": "allowGlobalAutomatic",
  "optionalsAsNullable": true,
  "payloadlessEnumsAsJavaEnums": true,
  "nullableAnnotation": "org.jetbrains.annotations.Nullable",
  "nonNullAnnotation": "org.jetbrains.annotations.NotNull",
  "foundationTypesAsJavaTypes": true,
  "closureMethodName": "invoke",
  "nativeLibraryName": "ShapesApp"
}
